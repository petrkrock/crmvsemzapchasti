# ============================================================
# ВСЕМЗАПЧАСТИ CRM — переменные окружения
# ============================================================
#
# Скопируйте этот файл в .env (в корне проекта) и заполните значения
# из вашего проекта Supabase: Project Settings → API.
#
# Для production эти две переменные обязательны. Локальный демо-режим
# включается только явно через VITE_DEMO_MODE=true (данные хранятся только в
# localStorage браузера, без сервера). Подробности — в README.md.

# URL вашего проекта Supabase, напр. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Публичный anon key проекта (НЕ service_role key!)
# Project Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=

# ── Только для self-hosted (server/monitor-server.js), НЕ для браузера ──
# PORT=3000
# PM2_APP_NAME=crm
# SUPABASE_SERVICE_ROLE_KEY=    # Supabase → Settings → API; живёт только на сервере
# PM2_LOG_DIR=/root/.pm2/logs
# NGINX_ERROR_LOG=/var/log/nginx/error.log
# NGINX_ACCESS_LOG=/var/log/nginx/access.log

# ── Уведомления о заявках с публичных форм (задаются в Supabase Dashboard →
#    Edge Functions → Manage Secrets для функции public-form, НЕ в .env фронта) ──
# TELEGRAM_BOT_TOKEN=          # токен от @BotFather
# TELEGRAM_CHAT_ID=            # общий чат/группа админов (личный id — через @userinfobot)
# MAX_BOT_TOKEN=               # токен бота MAX (MasterBot в мессенджере / business.max.ru)
# MAX_CHAT_ID=                 # chat_id чата в MAX (число)
# RESEND_API_KEY=              # API-ключ resend.com
# NOTIFY_EMAIL=                # почта получателя заявок
# NOTIFY_EMAIL_FROM=           # отправитель, напр. "CRM <crm@вашдомен.ru>"
# Персональная маршрутизация: в CRM → Настройки → Пользователи у менеджера
# заполняется «Chat ID для уведомлений» — он получает заявки «своих» разделов.

# Демо-режим (данные в localStorage, вход admin@admin.com / admin123).
# ВКЛЮЧАТЬ ТОЛЬКО ДЛЯ ЛОКАЛЬНОЙ ДЕМОНСТРАЦИИ. В проде без VITE_SUPABASE_* и без
# этого флага приложение намеренно не запускается (громкая ошибка конфигурации).
# VITE_DEMO_MODE=true
